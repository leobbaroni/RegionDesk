{
  "name": "regiondesk",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "An isolated regional browsing workspace for Windows",
  "author": "RegionDesk",
  "license": "UNLICENSED",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/desktop-test.mjs",
    "package": "npm run build && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "local.regiondesk.desktop",
    "productName": "RegionDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraFiles": [
      {
        "from": "Start Here.txt",
        "to": "Start Here.txt"
      },
      {
        "from": "docs/THIRD_PARTY.md",
        "to": "Third-party notices.txt"
      },
      {
        "from": "docs/GHOSTERY-LICENSE.txt",
        "to": "GHOSTERY-LICENSE.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "RegionDesk-${version}-Setup.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RegionDesk",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@ghostery/adblocker": "2.18.2",
    "lucide-react": "^1.46.0",
    "proxy-chain": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
